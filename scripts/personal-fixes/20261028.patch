+      ? []
+      : [
+          `context ${compactCount.format(agent.contextTokens)}${agent.contextWindow === undefined ? "" : ` / ${compactCount.format(agent.contextWindow)}`}`,
+        ]),
+    `$${agent.cost.toFixed(4)}`,
+    `${Math.floor(agent.durationMs / 1000)}s`,
+  ].join(" · ");
+}
