+          if (row === "R1") {
+            yield* dispatch("FRESH independent prompt");
+            yield* wait(
+              "fresh-completed",
+              (p) =>
+                p.runs.length === 3 &&
+                p.runs.every((r) => r.status === "completed") &&
+                p.messages.some(
+                  (m) => m.role === "assistant" && m.text.includes("Fresh turn works."),
+                ),
+            );
+          }
+          if (row === "R2") {
+            const elapsed =
+              Number(BigInt(confirmations.at(-1).mono) - BigInt(confirmations[0].mono)) / 1e9;
